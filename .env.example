# ==============================================================================
# XPLORE Detective Case System — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Bắt buộc cho Runtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 2. Next.js & App Configuration
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Google Workspace / Sheets (OPS-ONLY — KHÔNG DÙNG CHO RUNTIME)
# ------------------------------------------------------------------------------
# Chú ý: Toàn bộ runtime đọc/ghi Supabase 100%. Các biến GOOGLE_* dưới đây
# CHỈ DÙNG CHO OPS SCRIPTS (scripts/ops/*) khi cần seed/sync một lần từ Google Sheets/Docs.
# Không bắt buộc khi chạy app thông thường.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=1h2P9VaBC9PELUMhipo6ze1SkJIVv3IOm5SP3ynURm4Q
WAITLIST_SHEET_ID=
WAITLIST_SHEET_TAB=Waitlist
